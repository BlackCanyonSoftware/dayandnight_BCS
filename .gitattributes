# One line ending in the repository; the working tree gets the platform's.
* text=auto eol=lf

# Windows-only scripts are checked out with CRLF or the shell mis-reads them.
*.cmd  text eol=crlf
*.ps1  text eol=crlf
*.vbs  text eol=crlf

# Binary, never diffed or line-ending-converted.
*.png  binary
*.jpg  binary
*.ico  binary
*.ttf  binary
*.mp4  binary
*.node binary

# Generated; keep it out of diffs but in the repository.
package-lock.json -diff linguist-generated

# A brandkit bundle, verified by a hash of every file. `eol=lf` above would
# rewrite the two the kit happens to write with CRLF, and `brandkit check`
# compares bytes - so a fresh clone would report a brand that had quietly
# forked, in a repository nobody had touched. Stored exactly as the kit wrote
# it. Still diffed: a brand rebuild that changes the typeface shows up as a
# line in template/tokens.css, which is how it gets noticed.
app/brand/** -text

# Ours, not the kit's, and the only file in there that is written by hand.
app/brand/README.md text eol=lf

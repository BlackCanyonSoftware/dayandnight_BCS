  "roles": {
    "accent": "links, focus rings, the one word that is not ink",
    "bad": "something is wrong: an error",
    "bad_bg": "the wash behind an error",
    "brand": "fills: buttons, bars, the rule across the top",
    "card": "a raised surface on the page",
    "control": "the edge of a text box, a select, a switch track. 3:1, because the edge is the only thing that says where the control is",
    "ink": "body text, headings, the name itself",
    "line": "borders and dividers",
    "logo": "the mark, and any word set to match it",
    "mute": "small print, captions, secondary text",
    "ok": "something worked",
    "ok_bg": "the wash behind it",
    "on_bad": "text on a solid red fill",
    "on_brand": "text and icons on top of a brand fill - never --page, which on a mid-toned brand reads at 3:1",
    "page": "the background behind everything",
    "warn": "...and a warning. The same red, because two reds a few degrees apart are not distinguishable - a warning is told apart by its icon and the weight of its edge",
